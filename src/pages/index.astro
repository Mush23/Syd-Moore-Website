---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Cover from "../components/Cover.astro";
import StatusTag from "../components/StatusTag.astro";
import QuoteBlock from "../components/QuoteBlock.astro";
import NewsletterBand from "../components/NewsletterBand.astro";
import EventRow from "../components/EventRow.astro";
import { bookStatus, bookUrl, getBooks, getFeaturedBook, getSeries, getSeriesList, seriesPosition } from "../lib/books";
import { formatDate, fromLondon, buildNow } from "../lib/dates";
import { personLd, websiteLd } from "../lib/jsonld";

const featured = await getFeaturedBook();
const featuredSeries = await getSeries(featured.data.series);
const status = bookStatus(featured);
const books = await getBooks();
const seriesList = await getSeriesList();

// Hero fan: up to two earlier books in the same series sit behind the featured cover.
const fanBack = featured.data.series === "standalones"
  ? []
  : books.filter((b) => b.data.series === featured.data.series && b.data.order < featured.data.order).slice(-2);
// Large faint initial behind the hero copy, e.g. "W" for Section W (decorative).
const watermark = featuredSeries?.data.shortName.split(" ").pop()?.charAt(0) ?? "";

const now = buildNow();
const upcoming = (await getCollection("events", ({ data }) => !data.draft))
  .filter((e) => fromLondon(e.data.end ?? e.data.start) >= now)
  .sort((a, b) => fromLondon(a.data.start).getTime() - fromLondon(b.data.start).getTime())
  .slice(0, 3);

const about = await getEntry("pages", "about");

// Praise band: the first available quote from the series lead-in books.
const praise = ["strange-magic", "the-grand-illusion", "the-witching-hour"]
  .map((id) => books.find((b) => b.id === id)?.data.quotes[0])
  .find((q): q is { text: string; source: string } => Boolean(q));

const label = status === "pre-order"
  ? `New · ${seriesPosition(featured, featuredSeries)} · ${formatDate(featured.data.pubDate)}`
  : `${status === "coming-soon" ? "Coming soon" : "Out now"} · ${seriesPosition(featured, featuredSeries)}`;
---
<BaseLayout jsonLd={[websiteLd(), personLd()]}>
  <section class="hero band-night band-candle" aria-labelledby="hero-title" data-accent={featuredSeries?.data.accent}>
    {watermark && <span class="watermark" aria-hidden="true">{watermark}</span>}
    <div class="container hero-grid">
      <div class:list={["fan", `fan-${fanBack.length}`]}>
        {fanBack.map((b, i) => (
          <div class={`fan-back fan-back-${fanBack.length - i}`} aria-hidden="true">
            <Cover book={b} series={featuredSeries} width={220} decorative />
          </div>
        ))}
        <div class="fan-front">
          <Cover book={featured} series={featuredSeries} width={320} loading="eager" />
        </div>
      </div>
      <div class="hero-copy frame">
        <p class="label hero-label">{label}</p>
        <h1 id="hero-title">{featured.data.title}</h1>
        <p class="hero-hook">{featured.data.hook}</p>
        <p><StatusTag status={status} /></p>
        <div class="btn-row">
          <a class="btn btn-primary" href={`${bookUrl(featured)}#buy-${featured.id}`}>
            {status === "pre-order" ? "Pre-order now" : status === "coming-soon" ? "Find out more" : "Buy now"}
          </a>
          {featuredSeries && featuredSeries.id !== "standalones" && (
            <a class="btn btn-secondary" href={`/series/${featuredSeries.id}`}>Discover {featuredSeries.data.shortName}</a>
          )}
        </div>
      </div>
    </div>
  </section>

  {praise && (
    <section class="container praise" aria-label="Praise">
      <QuoteBlock text={praise.text} source={praise.source} size="large" />
    </section>
  )}

  <section class="container section-tight series-panels" aria-labelledby="series-heading">
    <h2 id="series-heading" class="visually-hidden">The series</h2>
    <p class="lede welcome">
      Syd Moore writes mysteries with history in their bones: witty, spooky stories drawn from the real witch trials,
      folklore and wartime secrets of Essex and beyond.
    </p>
    {seriesList.map((s) => {
      const first = books.find((b) => b.id === s.data.startHere);
      const inSeries = books.filter((b) => b.data.series === s.id);
      return (
        <article class="series-panel panel-tint" data-accent={s.data.accent} aria-labelledby={`sp-${s.id}`}>
          <div class="series-copy">
            <p class="label accent">{s.data.label}</p>
            <h3 id={`sp-${s.id}`}><a href={`/series/${s.id}`}>{s.data.name}</a></h3>
            <p>{s.data.tagline}</p>
            {first && <a class="text-link" href={bookUrl(first)}>Start with {first.data.title} <span aria-hidden="true">→</span></a>}
          </div>
          <ul class="series-covers" aria-label={`${s.data.name} books`}>
            {inSeries.map((b) => (
              <li>
                <a href={bookUrl(b)} aria-label={b.data.title}>
                  <Cover book={b} series={s} width={140} decorative />
                </a>
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </section>

  <NewsletterBand idPrefix="home-nl" />

  {upcoming.length > 0 && (
    <section class="container section" aria-labelledby="events-heading">
      <div class="section-head">
        <h2 id="events-heading">Coming up</h2>
        <a href="/events">See all events</a>
      </div>
      {upcoming.map((e) => <EventRow event={e} />)}
    </section>
  )}

  <section class="container section meet" aria-labelledby="meet-heading">
    <div class="meet-copy">
      <p class="label accent-brass">About</p>
      <h2 id="meet-heading">Meet Syd</h2>
      <p>{about?.data.shortBio}</p>
      <a class="btn btn-secondary" href="/about">More about Syd</a>
    </div>
    <aside class="eglf band-night" aria-labelledby="eglf-heading">
      <p class="label accent-brass-light">Essex Girls & Witches</p>
      <h2 id="eglf-heading">The women history called witches</h2>
      <p>
        The women of Essex were called witches for centuries. Now they're called something else. Syd co-founded the
        Essex Girls Liberation Front to change that.
      </p>
      <a class="btn btn-primary" href="/essex-girls-and-witches">Read the story</a>
    </aside>
  </section>
</BaseLayout>

<style>
  /* ---- Hero: candlelit band, fanned covers, framed copy ---- */
  .hero { padding-block: var(--space-5); }
  .watermark {
    position: absolute;
    z-index: -1;
    right: -2rem;
    top: -6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22rem, 15rem + 30vw, 42rem);
    line-height: 1;
    color: color-mix(in srgb, var(--accent-light, var(--brass-light)) 6%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .hero-grid {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 810px) {
    .hero { padding-block: var(--space-6); }
    .hero-grid { grid-template-columns: minmax(18rem, 27rem) 1fr; gap: var(--space-5); }
  }

  .fan { position: relative; width: min(100%, 22rem); margin-inline: auto; }
  .fan-front { position: relative; z-index: 2; width: 66%; margin-left: auto; transform: rotate(4deg); }
  .fan-0 .fan-front { width: 72%; margin-inline: auto; transform: none; }
  .fan-back { position: absolute; top: 9%; width: 54%; filter: brightness(0.72) saturate(0.9); }
  .fan-back-1 { left: 16%; transform: rotate(-3deg); z-index: 1; }
  .fan-back-2 { left: 0; top: 13%; transform: rotate(-9deg); }
  .fan-1 .fan-back-1 { left: 4%; transform: rotate(-6deg); }
  @media (min-width: 810px) { .fan { width: 100%; } }

  .frame {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--brass-light) 45%, transparent);
    padding: var(--space-4) var(--space-3);
  }
  @media (min-width: 810px) { .frame { padding: var(--space-5) var(--space-4); } }
  .frame::before, .frame::after {
    content: "✦";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 0.6rem;
    font-size: 0.875rem;
    line-height: 1;
    color: var(--brass-light);
    background: #16121a;
  }
  .frame::before { top: -0.45rem; }
  .frame::after { bottom: -0.45rem; }
  .hero-copy > * + * { margin-top: var(--space-2); }
  .hero-label { color: var(--accent-light, var(--brass-light)); }
  .hero-hook { font-family: var(--font-display); font-style: italic; font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem); line-height: 1.4; max-width: 36rem; color: var(--parchment); }
  .hero .btn-row { margin-top: var(--space-3); }

  /* ---- Praise: large italic pull quote ---- */
  .praise { display: flex; justify-content: center; padding-block: var(--space-6) var(--space-4); }
  .praise :global(.quote) { margin-inline: auto; }

  /* ---- Series: tinted panels showing every book ---- */
  .welcome {
    max-width: 52rem;
    margin: 0 auto var(--space-4);
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.6rem);
    line-height: 1.45;
  }
  .series-panels { display: grid; gap: var(--space-3); }
  .series-panel { display: grid; gap: var(--space-3); align-items: center; }
  @media (min-width: 960px) { .series-panel { grid-template-columns: minmax(16rem, 22rem) 1fr; gap: var(--space-5); } }
  .series-copy > * + * { margin-top: var(--space-1); }
  .series-copy h3 { font-size: var(--h2); font-weight: 500; }
  .series-copy h3 a { color: inherit; text-decoration: none; }
  .series-copy h3 a:hover { text-decoration: underline; }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: var(--tap);
    margin-top: var(--space-1);
    font-weight: 600;
    color: var(--ink);
    text-underline-offset: 0.3em;
  }
  .series-covers {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: var(--space-2);
  }
  @media (min-width: 810px) { .series-covers { grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); } }
  .series-covers a { display: block; border-radius: 4px; text-decoration: none; transition: transform var(--duration) ease; }
  .series-covers a:hover { transform: translateY(-4px); }
  @media (prefers-reduced-motion: reduce) { .series-covers a { transition: none; } .series-covers a:hover { transform: none; } }

  .accent { color: var(--accent); }
  .accent-brass { color: var(--brass); }
  .accent-brass-light { color: var(--brass-light); }

  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-2); }

  .meet { display: grid; gap: var(--space-4); }
  @media (min-width: 810px) { .meet { grid-template-columns: 1.1fr 1fr; align-items: start; } }
  .meet-copy > * + *, .eglf > * + * { margin-top: var(--space-2); }
  .eglf { padding: var(--space-4); border-radius: var(--radius); }
</style>
