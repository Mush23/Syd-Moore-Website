---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import sydWoodland from "../assets/photos/syd-moore-woodland.jpg";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Cover from "../components/Cover.astro";
import Book3D from "../components/Book3D.astro";
import StatusTag from "../components/StatusTag.astro";
import QuoteBlock from "../components/QuoteBlock.astro";
import PraiseWall from "../components/PraiseWall.astro";
import NewsletterBand from "../components/NewsletterBand.astro";
import EventRow from "../components/EventRow.astro";
import { bookStatus, bookUrl, getBooks, getFeaturedBook, getSeries, getSeriesList, seriesPosition } from "../lib/books";
import { formatDate, fromLondon, buildNow } from "../lib/dates";
import { personLd, websiteLd } from "../lib/jsonld";
import { site } from "../config/site";

const featured = await getFeaturedBook();
const featuredSeries = await getSeries(featured.data.series);
const status = bookStatus(featured);
const books = await getBooks();
const seriesList = await getSeriesList();

// Hero fan: up to two earlier books in the same series sit behind the featured cover.
const fanBack = featured.data.series === "standalones"
  ? []
  : books.filter((b) => b.data.series === featured.data.series && b.data.order < featured.data.order).slice(-2);
// Large faint initial behind the hero copy, e.g. "W" for Section W (decorative).
const watermark = featuredSeries?.data.shortName.split(" ").pop()?.charAt(0) ?? "";

const now = buildNow();
const upcoming = (await getCollection("events", ({ data }) => !data.draft))
  .filter((e) => fromLondon(e.data.end ?? e.data.start) >= now)
  .sort((a, b) => fromLondon(a.data.start).getTime() - fromLondon(b.data.start).getTime())
  .slice(0, 3);

const about = await getEntry("pages", "about");
const byId = (id: string) => books.find((b) => b.id === id);
const strangeMagic = byId("strange-magic");
const grandIllusion = byId("the-grand-illusion");

// Praise band: the first available quote from the series lead-in books.
const praise = ["strange-magic", "the-grand-illusion", "the-witching-hour"]
  .map((id) => byId(id)?.data.quotes[0])
  .find((q): q is { text: string; source: string } => Boolean(q));

const label = status === "pre-order"
  ? `New · ${seriesPosition(featured, featuredSeries)} · ${formatDate(featured.data.pubDate)}`
  : `${status === "coming-soon" ? "Coming soon" : "Out now"} · ${seriesPosition(featured, featuredSeries)}`;

// Hero figures. Counts come from the book files; the shortlists are from the press fact sheet.
const published = books.filter((b) => bookStatus(b) === "out-now").length;
const stats = [
  { n: String(published), label: "books published", icon: "book-open" },
  { n: String(seriesList.filter((s) => s.id !== "standalones").length), label: "series, plus standalone novels", icon: "library" },
  { n: "2×", label: "shortlisted for the CWA Short Story Dagger", icon: "award" },
];
---
<BaseLayout jsonLd={[websiteLd(), personLd()]}>
  <section class="hero band-night band-candle" aria-labelledby="hero-title" data-accent={featuredSeries?.data.accent}>
    {/* Drawn with CSS generated content so this huge decorative letter isn't measured as the page's main content. */}
    {watermark && <span class="watermark" aria-hidden="true" data-letter={watermark}></span>}
    <div class="container hero-grid">
      <div class:list={["fan", `fan-${fanBack.length}`]}>
        {fanBack.map((b, i) => (
          <div class={`fan-back fan-back-${fanBack.length - i}`} aria-hidden="true">
            <Cover book={b} series={featuredSeries} width={140} decorative />
          </div>
        ))}
        <div class="fan-front">
          <Book3D book={featured} series={featuredSeries} width={320} loading="eager" float sizes="(min-width: 900px) 19rem, 13.5rem" />
        </div>
      </div>
      <div class="hero-copy">
        <p class="strap">Syd Moore writes witty, spooky mysteries rooted in real Essex history.</p>
        <p class="label hero-label"><span class="pulse" aria-hidden="true"></span>{label}</p>
        <h1 id="hero-title">{featured.data.title}</h1>
        <p class="hero-hook">{featured.data.hook}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={`${bookUrl(featured)}#buy-${featured.id}`}>
            {status === "pre-order" ? "Pre-order now" : status === "coming-soon" ? "Find out more" : "Buy now"}
            <Icon name="arrow-right" class="arrow" />
          </a>
          {featuredSeries && featuredSeries.id !== "standalones" && (
            <a class="btn btn-secondary" href={`/series/${featuredSeries.id}`}>Discover {featuredSeries.data.shortName}</a>
          )}
        </div>
        {status === "pre-order" && <p class="hero-status"><StatusTag status={status} /></p>}
      </div>
    </div>
    <dl class="container stats">
      {stats.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd><Icon name={s.icon} size="1.5rem" class="stat-icon" />{s.n}</dd>
        </div>
      ))}
    </dl>
  </section>

  {praise && (
    <section class="container praise reveal" aria-label="Praise">
      <QuoteBlock text={praise.text} source={praise.source} size="large" />
    </section>
  )}

  <section class="container section-tight series-panels" aria-labelledby="series-heading">
    <div class="section-intro reveal">
      <p class="eyebrow accent-brass"><Icon name="library" />The books</p>
      <h2 id="series-heading" class="display">Two series and two haunting standalones</h2>
    </div>
    {seriesList.map((s) => {
      const first = byId(s.data.startHere);
      const inSeries = books.filter((b) => b.data.series === s.id);
      return (
        <article class="series-panel reveal" data-accent={s.data.accent} aria-labelledby={`sp-${s.id}`}>
          <span class="ghost" aria-hidden="true">{String(inSeries.length).padStart(2, "0")}</span>
          <div class="series-copy">
            <p class="label accent">{s.data.label}</p>
            <h3 id={`sp-${s.id}`}><a href={`/series/${s.id}`}>{s.data.name}</a></h3>
            <p>{s.data.tagline}</p>
            {first && <a class="btn btn-accent" href={bookUrl(first)}>Start with {first.data.title} <Icon name="arrow-right" class="arrow" /></a>}
          </div>
          <ul class="series-covers" aria-label={`${s.data.name} books`}>
            {inSeries.map((b) => (
              <li>
                <a href={bookUrl(b)} style={`view-transition-name: cover-${b.id}`}>
                  <span class="cover-slot"><Cover book={b} series={s} width={140} decorative /></span>
                  <span class="cover-caption">
                    <span class="visually-hidden">{b.data.title}, </span>
                    {b.data.seriesNumber ? `Book ${b.data.seriesNumber}` : (b.data.seriesNote ?? (s.id === "standalones" ? "Novel" : "Also"))}
                    {b.id === s.data.startHere && <span class="start">Start here</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </section>

  <PraiseWall books={books} limit={9} exclude={praise?.text} />

  <NewsletterBand idPrefix="home-nl" />

  {upcoming.length > 0 && (
    <section class="container section" aria-labelledby="events-heading">
      <div class="section-head">
        <h2 id="events-heading" class="display">Coming up</h2>
        <a href="/events">See all events</a>
      </div>
      {upcoming.map((e) => <EventRow event={e} />)}
    </section>
  )}

  <section class="container section bento" aria-labelledby="meet-heading">
    <article class="tile tile-meet reveal">
      <Image
        src={sydWoodland}
        alt="Syd Moore in autumn woodland"
        widths={[320, 640, 768]}
        sizes="(min-width: 640px) 16rem, 100vw"
        class="meet-photo"
      />
      <div class="meet-copy">
        <p class="eyebrow accent-brass"><Icon name="user-round" />About</p>
        <h2 id="meet-heading" class="display">Meet Syd</h2>
        <p class="tile-text">{about?.data.shortBio}</p>
        <div class="tile-actions">
          <a class="btn btn-secondary" href="/about">More about Syd <Icon name="arrow-right" class="arrow" /></a>
          <SocialLinks tone="light" />
        </div>
      </div>
    </article>

    <article class="tile tile-eglf band-night band-candle reveal" data-accent="oxblood" aria-labelledby="eglf-heading">
      <p class="eyebrow accent-brass-light"><Icon name="flame" />Essex Girls &amp; Witches</p>
      <h2 id="eglf-heading">The women history called witches</h2>
      <p>
        The women of Essex were called witches for centuries. Now they're called something else. Syd co-founded the
        Essex Girls Liberation Front to change that.
      </p>
      <a class="btn btn-primary" href="/essex-girls-and-witches">Read the story <Icon name="arrow-right" class="arrow" /></a>
    </article>

    {strangeMagic && grandIllusion && (
      <article class="tile tile-start reveal" aria-labelledby="start-heading">
        <p class="eyebrow accent-brass"><Icon name="book-open" />New here?</p>
        <h2 id="start-heading">Where to start</h2>
        <ul class="start-list">
          <li data-accent="witch-green">
            <a href={bookUrl(strangeMagic)}><cite>{strangeMagic.data.title}</cite><span>for witches and wit <Icon name="arrow-right" class="arrow" /></span></a>
          </li>
          <li data-accent="oxblood">
            <a href={bookUrl(grandIllusion)}><cite>{grandIllusion.data.title}</cite><span>for wartime espionage <Icon name="arrow-right" class="arrow" /></span></a>
          </li>
        </ul>
      </article>
    )}

    <article class="tile tile-events reveal" aria-labelledby="tile-events-heading">
      <p class="eyebrow accent-brass"><Icon name="calendar" />Events</p>
      <h2 id="tile-events-heading">Talks, signings and festivals</h2>
      <p>See where Syd is appearing next, or book her for your festival, library or book group.</p>
      <a class="tile-link" href="/events">Events and talks <Icon name="arrow-right" class="arrow" /></a>
    </article>

    <article class="tile tile-news reveal" aria-labelledby="tile-news-heading">
      <p class="eyebrow accent-brass"><Icon name="mail" />Newsletter</p>
      <h2 id="tile-news-heading">{site.newsletter.name}</h2>
      <p>New books, events and history notes from Syd's research. Once a month at most.</p>
      <a class="tile-link" href="/newsletter">About the newsletter <Icon name="arrow-right" class="arrow" /></a>
    </article>

    <article class="tile tile-faq reveal" aria-labelledby="tile-faq-heading">
      <p class="eyebrow accent-brass"><Icon name="circle-help" />FAQ</p>
      <h2 id="tile-faq-heading">Reading order and more</h2>
      <p>Which book comes next, which have audiobooks, and where to buy locally.</p>
      <a class="tile-link" href="/faq">Read the answers <Icon name="arrow-right" class="arrow" /></a>
    </article>
  </section>
</BaseLayout>

<style>
  /* ---- Hero: candlelit band, 3D book in front of a fan, oversized title ---- */
  .hero { padding-block: var(--space-5) 0; }
  .watermark::before { content: attr(data-letter); }
  .watermark {
    position: absolute;
    z-index: -1;
    right: -2rem;
    top: -6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22rem, 15rem + 30vw, 46rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent-light, var(--brass-light)) 16%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .hero-grid {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .hero { padding-top: var(--space-6); }
    .hero-grid { grid-template-columns: minmax(20rem, 30rem) 1fr; gap: var(--space-6); min-height: min(70vh, 40rem); }
  }

  .fan { position: relative; width: min(100%, 21rem); margin-inline: auto; padding-block: var(--space-2); }
  .fan-front { position: relative; z-index: 2; width: 64%; margin-left: auto; margin-right: 6%; }
  .fan-0 .fan-front { width: 70%; margin-inline: auto; }
  .fan-back { position: absolute; top: 12%; width: 52%; filter: brightness(0.6) saturate(0.85); }
  .fan-back-1 { left: 14%; transform: rotate(-5deg); z-index: 1; }
  .fan-back-2 { left: 0; top: 16%; transform: rotate(-12deg); }
  .fan-1 .fan-back-1 { left: 4%; transform: rotate(-8deg); }
  @media (min-width: 900px) { .fan { width: 100%; } }

  .hero-copy > * + * { margin-top: var(--space-2); }
  .strap {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    color: var(--parchment-muted);
  }
  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-3);
    padding: 0.35rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--accent-light, var(--brass-light)) 45%, transparent);
    border-radius: 999px;
    color: var(--accent-light, var(--brass-light));
    background: rgb(255 255 255 / 0.04);
  }
  .pulse { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 0 currentColor; }
  @keyframes pulse { to { box-shadow: 0 0 0 0.6rem transparent; } }
  @media (prefers-reduced-motion: no-preference) { .pulse { animation: pulse 2s ease-out infinite; } }
  .hero h1 {
    font-size: clamp(2.75rem, 1.4rem + 5.6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 650;
    background: linear-gradient(180deg, #fffaf0 30%, color-mix(in srgb, var(--brass-light) 70%, #fffaf0));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }
  @media (forced-colors: active) { .hero h1 { color: CanvasText; background: none; } }
  .hero-hook { font-family: var(--font-display); font-style: italic; font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem); line-height: 1.4; max-width: 34rem; color: var(--parchment); }
  .hero .btn-row { margin-top: var(--space-4); }

  .stats {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  @media (min-width: 700px) { .stats { grid-template-columns: repeat(3, 1fr); margin-top: var(--space-6); } }
  .stat { display: flex; flex-direction: column-reverse; gap: 0.25rem; padding: var(--space-3) 0; }
  .stat + .stat { border-top: 1px solid rgb(255 255 255 / 0.12); }
  @media (min-width: 700px) {
    .stat { padding: var(--space-3) var(--space-3); }
    .stat:first-child { padding-left: 0; }
    .stat + .stat { border-top: 0; border-left: 1px solid rgb(255 255 255 / 0.12); }
  }
  .stat dd { display: flex; align-items: center; gap: 0.75rem; font-family: var(--font-display); font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3.25rem); font-weight: 600; line-height: 1; color: var(--brass-light); }
  .stat :global(.stat-icon) { color: var(--parchment-muted); }
  .stat dt { font-size: var(--small); color: var(--parchment-muted); max-width: 18rem; }

  /* ---- Praise: large italic pull quote ---- */
  .praise { display: flex; justify-content: center; padding-block: var(--space-6) var(--space-5); }
  .praise :global(.quote) { margin-inline: auto; }

  /* ---- Series showcases ---- */
  .section-intro { margin-bottom: var(--space-4); }
  .section-intro .display { margin-top: var(--space-1); max-width: 18ch; }
  .series-panels { display: grid; gap: var(--space-4); }
  .series-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-3);
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    background:
      radial-gradient(80% 120% at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent) 0, transparent 60%),
      linear-gradient(135deg, var(--surface), var(--accent-tint));
    box-shadow: 0 30px 60px -40px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  @media (min-width: 960px) {
    .series-panel { grid-template-columns: minmax(16rem, 23rem) 1fr; gap: var(--space-5); padding: var(--space-5); }
  }
  .ghost {
    position: absolute;
    z-index: -1;
    right: 1rem;
    bottom: -0.22em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(9rem, 6rem + 14vw, 17rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent) 22%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .series-copy > * + * { margin-top: var(--space-1); }
  .series-copy h3 { font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.75rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.05; }
  .series-copy h3 a { color: inherit; text-decoration: none; }
  .series-copy h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .btn-accent { margin-top: var(--space-2); background: var(--accent); color: #fffcf5; box-shadow: 0 10px 24px -10px var(--accent); }
  .btn-accent:hover { background: color-mix(in srgb, var(--accent) 85%, #000); }
  .series-covers {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: var(--space-3) var(--space-2);
    perspective: 1200px;
  }
  @media (min-width: 810px) { .series-covers { grid-template-columns: repeat(auto-fill, minmax(6.75rem, 1fr)); } }
  .series-covers a { display: block; border-radius: 4px; text-decoration: none; }
  .series-covers a :global(.cover) { transition: transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 350ms ease; transform-origin: left center; }
  .series-covers a:hover :global(.cover) {
    transform: translateY(-8px) rotateY(-14deg) scale(1.04);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 18px 28px 40px -14px rgb(0 0 0 / 0.5);
  }
  .cover-caption {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .cover-caption .start { display: block; color: var(--accent); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) {
    .series-covers a :global(.cover) { transition: none; }
    .series-covers a:hover :global(.cover) { transform: none; }
  }

  .accent { color: var(--accent); }
  .accent-brass { color: var(--brass); }
  .accent-brass-light { color: var(--brass-light); }

  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-2); }

  /* ---- Bento grid ---- */
  .bento { display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
  @media (min-width: 810px) {
    .bento { grid-template-columns: repeat(6, 1fr); }
    .tile-meet { grid-column: span 4; }
    .tile-eglf { grid-column: span 2; grid-row: span 2; }
    .tile-start { grid-column: span 4; }
    .tile-events, .tile-news, .tile-faq { grid-column: span 2; }
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 20px 40px -32px rgb(28 26 31 / 0.5);
    transition: transform var(--duration) ease, box-shadow var(--duration) ease;
  }
  @media (min-width: 810px) { .tile { padding: var(--space-4); } }
  @media (prefers-reduced-motion: no-preference) {
    .tile:hover { transform: translateY(-4px); box-shadow: 0 30px 50px -30px rgb(28 26 31 / 0.55); }
  }
  .tile h2:not(.display) { font-size: var(--h3); }
  .tile-meet { background: linear-gradient(135deg, var(--surface), var(--brass-tint)); gap: var(--space-3); }
  .tile-meet :global(.meet-photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 18px;
  }
  .meet-copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  @media (min-width: 640px) {
    .tile-meet { flex-direction: row; align-items: stretch; gap: var(--space-4); }
    .tile-meet :global(.meet-photo) { flex: none; width: 16rem; height: auto; aspect-ratio: auto; align-self: stretch; min-height: 18rem; }
    .meet-copy { flex: 1; justify-content: center; }
  }
  .tile-text { max-width: 44rem; font-size: 1.125rem; }
  .tile-eglf {
    border: 0;
    justify-content: flex-end;
    min-height: 20rem;
    color: var(--parchment);
    background:
      radial-gradient(90% 60% at 20% 0%, color-mix(in srgb, var(--oxblood) 55%, var(--night)) 0, transparent 70%),
      var(--night);
  }
  .tile-eglf h2 { font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.4rem) !important; line-height: 1.05; }
  .tile-link, .tile > .btn, .tile-actions { margin-top: auto; }
  .tile-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .tile-link { display: inline-flex; align-items: center; gap: 0.4rem; min-height: var(--tap); font-weight: 600; color: var(--ink); text-underline-offset: 0.3em; }
  .start-list { list-style: none; padding: 0; width: 100%; display: grid; gap: var(--space-2); }
  @media (min-width: 600px) { .start-list { grid-template-columns: 1fr 1fr; } }
  .start-list a {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-2) var(--space-3);
    border-radius: 16px;
    background: var(--accent-tint);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--duration) ease;
  }
  .start-list a:hover { background: color-mix(in srgb, var(--accent) 14%, var(--surface)); }
  .start-list cite { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; font-style: normal; color: var(--accent); }
  .start-list span { font-size: var(--small); }
</style>
