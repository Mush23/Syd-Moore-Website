---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterBand from "../components/NewsletterBand.astro";
import { personLd } from "../lib/jsonld";

const page = (await getEntry("pages", "about"))!;
const { Content } = await render(page);

// Author portrait: drop a file named "syd-moore-portrait.(jpg|png|webp)" into src/assets/photos.
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/syd-moore-portrait.{jpg,jpeg,png,webp}", { eager: true });
const portrait = Object.values(photos)[0]?.default;
---
<BaseLayout title="About Syd Moore · Essex novelist and campaigner" description={page.data.description} jsonLd={personLd()}>
  <header class="container page-header">
    <p class="label">About</p>
    <h1>About Syd</h1>
  </header>

  <div class="container about">
    <div class="prose story"><Content /></div>

    <aside class="facts" aria-labelledby="facts-heading">
      {portrait && (
        <Image src={portrait} alt="Syd Moore" widths={[320, 640]} sizes="(min-width: 810px) 320px, 100vw" class="portrait" />
      )}
      <h2 id="facts-heading" class="facts-heading">Quick facts</h2>
      <dl>
        {page.data.quickFacts?.map((f) => (<div><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
      </dl>
      <p><a class="btn btn-secondary" href="/press">Bios and photos for press</a></p>
    </aside>
  </div>

  <NewsletterBand idPrefix="about-nl" />
</BaseLayout>

<style>
  .about { display: grid; gap: var(--space-5); padding-bottom: var(--space-4); }
  @media (min-width: 810px) { .about { grid-template-columns: 1fr 20rem; align-items: start; } }
  .story :global(p:first-child) { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.4; }
  .facts {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
  }
  .facts > * + * { margin-top: var(--space-2); }
  .facts :global(.portrait) { border-radius: var(--radius); width: 100%; height: auto; }
  .facts-heading { font-size: var(--h3); }
  dl > div + div { margin-top: var(--space-1); }
  dt { font-size: var(--small); color: var(--ink-muted); }
  dd { font-weight: 500; }
</style>
