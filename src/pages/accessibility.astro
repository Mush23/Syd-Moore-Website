---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/dates";
const page = (await getEntry("pages", "accessibility"))!;
const { Content } = await render(page);
---
<BaseLayout title="Accessibility statement · Syd Moore" description={page.data.description}>
  <div class="container page-header">
    <p class="label">Legal</p>
    <h1>{page.data.title}</h1>
    {page.data.updated && <p class="muted">Last updated {formatDate(page.data.updated)}</p>}
  </div>
  <div class="container"><div class="prose"><Content /></div></div>
</BaseLayout>
