---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import interUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Path of the social image, e.g. /og/strange-magic.png */
  image?: string;
  imageAlt?: string;
  type?: "website" | "book" | "article";
  jsonLd?: object | object[];
  noindex?: boolean;
  accent?: "oxblood" | "witch-green" | "brass";
}

const {
  title,
  description = site.description,
  image = "/og/default.png",
  imageAlt = "Syd Moore, author",
  type = "website",
  jsonLd,
  noindex = false,
  accent,
} = Astro.props;

const fullTitle = title ? `${title}` : site.title;
const path = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "").replace(/\.html$/, "");
const canonical = new URL(path, site.url).toString();
const ogImage = new URL(image, site.url).toString();
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const cfBeacon = site.analytics.cloudflareToken ? JSON.stringify({ token: site.analytics.cloudflareToken }) : "";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* GitHub Pages can't send security headers, so the CSP and referrer policy live here. */}
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; form-action 'self' https://app.convertkit.com https://app.kit.com; base-uri 'self'; upgrade-insecure-requests" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#16141a" />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Syd Moore: news" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type === "book" ? "book" : type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <slot name="head" />
  </head>
  <body data-accent={accent}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {cfBeacon && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={cfBeacon}></script>
    )}
  </body>
</html>
