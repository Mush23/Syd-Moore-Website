---
interface Props { text: string; source: string; size?: "large" | "normal" }
const { text, source, size = "normal" } = Astro.props;
// The large variant shows a decorative opening mark instead of inline quote marks.
const clean = text.replace(/^[“"]|[”"]$/g, "");
---
<figure class:list={["quote", size]}>
  <blockquote><p>{size === "large" ? clean : `“${clean}”`}</p></blockquote>
  <figcaption>{source}</figcaption>
</figure>

<style>
  .quote { max-width: 46rem; }
  blockquote p {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.35;
    font-weight: 500;
    text-wrap: balance;
  }
  /* Large: a centred italic pull quote under an oversized, decorative quote mark. */
  .large { max-width: 60rem; text-align: center; }
  .large::before {
    content: "“";
    display: block;
    height: 0.45em;
    font-family: var(--font-display);
    font-size: clamp(7rem, 5rem + 6vw, 11rem);
    line-height: 0.8;
    color: color-mix(in srgb, var(--oxblood) 25%, var(--paper));
  }
  .large blockquote p { font-size: clamp(1.9rem, 1.2rem + 3vw, 3.4rem); font-style: italic; line-height: 1.15; }
  .large figcaption { margin-top: var(--space-2); color: var(--ink-muted); }
  figcaption {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  figcaption::before { content: "— "; }
</style>
