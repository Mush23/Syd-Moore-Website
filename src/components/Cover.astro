---
/**
 * A book cover at its true 2:3 ratio. Uses the uploaded cover when there is one,
 * otherwise an accessible typographic placeholder in the series accent colour.
 */
import { Image } from "astro:assets";
import { coverAlt, coverImage, type Book, type Series } from "../lib/books";

interface Props {
  book: Book;
  series?: Series;
  /** Rendered width in CSS pixels, used for responsive sizes. */
  width?: number;
  loading?: "eager" | "lazy";
  /** When the cover sits inside a link that already names the book, hide it from screen readers. */
  decorative?: boolean;
}
const { book, series, width = 240, loading = "lazy", decorative = false } = Astro.props;
const img = coverImage(book);
const accent = series?.data.accent ?? "brass";
const alt = decorative ? "" : coverAlt(book);
---
<div class="cover" data-accent={accent}>
  {img ? (
    <Image
      src={img}
      alt={alt}
      widths={[width, width * 2]}
      sizes={`${width}px`}
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : undefined}
      format="avif"
    />
  ) : (
    <div class="placeholder" role={decorative ? "presentation" : "img"} aria-label={decorative ? undefined : alt}>
      <span class="ph-series" aria-hidden="true">{series?.data.shortName ?? ""}</span>
      <span class="ph-title" aria-hidden="true">{book.data.title}</span>
      <span class="ph-author" aria-hidden="true">Syd Moore</span>
    </div>
  )}
</div>

<style>
  .cover {
    aspect-ratio: 2 / 3;
    width: 100%;
    border-radius: 2px 5px 5px 2px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 18px 36px -10px rgb(0 0 0 / 0.4);
    background: var(--accent);
  }
  .cover :global(img) { width: 100%; height: 100%; object-fit: contain; background: var(--surface); }
  .placeholder {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 13% 12%;
    color: #fffcf5;
    /* Spine shading, a soft highlight and paper grain so the placeholder reads as a book. */
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.32) 0, rgb(255 255 255 / 0.1) 2.5%, rgb(0 0 0 / 0.08) 5%, transparent 9%),
      radial-gradient(120% 80% at 30% 12%, rgb(255 255 255 / 0.16), transparent 60%),
      var(--grain),
      var(--accent);
    container-type: inline-size;
  }
  .placeholder::after {
    content: "";
    position: absolute;
    inset: 5%;
    border: 1px solid rgb(255 252 245 / 0.35);
    pointer-events: none;
  }
  .ph-series {
    font-family: var(--font-mono);
    font-size: max(0.5625rem, 6.5cqi);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ph-title {
    font-family: var(--font-display);
    font-size: max(0.6875rem, 11.5cqi);
    line-height: 1.05;
    font-weight: 600;
    text-wrap: balance;
    overflow-wrap: normal;
  }
  .ph-author {
    font-family: var(--font-display);
    font-size: max(0.625rem, 7.5cqi);
    border-top: 1px solid rgb(255 252 245 / 0.6);
    padding-top: 6%;
  }
</style>
