---
/**
 * A cover shown as a three-dimensional book: front cover, page block and a soft
 * floor shadow. Pure CSS. It straightens on hover and stays flat-on (still with
 * its page edge) when the visitor prefers reduced motion.
 */
import Cover from "./Cover.astro";
import type { Book, Series } from "../lib/books";

interface Props {
  book: Book; series?: Series; width?: number; loading?: "eager" | "lazy"; decorative?: boolean; float?: boolean;
  /** Set on a book's own page so its cover morphs in from the card the visitor clicked. */
  morph?: boolean;
}
const { book, series, width = 320, loading = "lazy", decorative = false, float = false, morph = false } = Astro.props;
const accent = series?.data.accent ?? "brass";
---
<div class:list={["book3d", { float }]} data-accent={accent} style={morph ? `view-transition-name: cover-${book.id}` : undefined}>
  <div class="book3d-inner">
    <Cover book={book} series={series} width={width} loading={loading} decorative={decorative} />
  </div>
</div>

<style>
  .book3d { --depth: clamp(18px, 9cqi, 38px); perspective: 1600px; container-type: inline-size; width: 100%; }
  .book3d-inner {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateY(-24deg) rotateX(3deg);
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .book3d:hover .book3d-inner { transform: rotateY(-8deg) rotateX(1deg); }
  .book3d-inner :global(.cover) {
    position: relative;
    transform: translateZ(calc(var(--depth) / 2));
    box-shadow: none;
  }
  /* Page block on the fore-edge. */
  .book3d-inner::before {
    content: "";
    position: absolute;
    top: 1.2%;
    bottom: 1.2%;
    right: 0;
    width: var(--depth);
    transform: translateX(50%) rotateY(90deg);
    background: repeating-linear-gradient(90deg, #f3ead8 0 1px, #d9cdb4 1px 2px, #efe5d0 2px 3px);
    box-shadow: inset 0 0 6px rgb(0 0 0 / 0.25);
  }
  /* Back cover, which also casts the floor shadow. */
  .book3d-inner::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateZ(calc(var(--depth) / -2));
    background: color-mix(in srgb, var(--accent, #3a2a12) 60%, #000);
    border-radius: 2px 5px 5px 2px;
    box-shadow: -18px 30px 50px -8px rgb(0 0 0 / 0.55), -6px 10px 16px rgb(0 0 0 / 0.3);
  }
  @keyframes book-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -10px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .float { animation: book-float 7s ease-in-out infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .book3d-inner { transition: none; }
  }
</style>
