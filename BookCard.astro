---
import Cover from "./Cover.astro";
import StatusTag from "./StatusTag.astro";
import { bookStatus, bookUrl, seriesPosition, type Book, type Series } from "../lib/books";
interface Props { book: Book; series?: Series; headingLevel?: 2 | 3; showHook?: boolean }
const { book, series, headingLevel = 3, showHook = true } = Astro.props;
const status = bookStatus(book);
const H = `h${headingLevel}` as "h2" | "h3";
---
<article class="book-card">
  <a class="card-link" href={bookUrl(book)}>
    <Cover book={book} series={series} width={220} decorative />
    <H class="card-title">{book.data.title}</H>
  </a>
  <p class="card-series muted">{seriesPosition(book, series)}</p>
  {status !== "out-now" && <p><StatusTag status={status} /></p>}
  {showHook && <p class="card-hook">{book.data.hook}</p>}
</article>

<style>
  .book-card { display: flex; flex-direction: column; gap: 0.35rem; }
  .card-link { color: inherit; text-decoration: none; display: flex; flex-direction: column; gap: var(--space-2); }
  .card-link:hover .card-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  .card-link :global(.cover) { transition: transform var(--duration) ease; }
  @media (prefers-reduced-motion: no-preference) {
    .card-link:hover :global(.cover) { transform: translateY(-3px); }
  }
  .card-title { font-size: 1.2rem; line-height: 1.2; }
  .card-series { font-size: var(--small); }
  .card-hook { font-size: var(--small); line-height: 1.5; }
</style>
