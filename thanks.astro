---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Message sent · Syd Moore" description="Thanks for getting in touch." noindex>
  <div class="container page-header">
    <p class="label">Contact</p>
    <h1>Thank you</h1>
    <p class="lede">Your message is on its way. Syd or her team will reply as soon as they can.</p>
    <p class="btn-row cta"><a class="btn btn-primary" href="/books">Browse the books</a></p>
  </div>
</BaseLayout>
<style>.cta { margin-top: var(--space-3); }</style>
