# Copy to .env for local development. In production, set these in
# GitHub → the repository → Settings → Secrets and variables → Actions → Variables.
# They are public values baked into the pages at build time (see docs/DEPLOY.md).

PUBLIC_KIT_FORM_ACTION=           # e.g. https://app.kit.com/forms/1234567/subscriptions
PUBLIC_CF_ANALYTICS_TOKEN=        # Cloudflare Web Analytics token (works on any host)
PUBLIC_AMAZON_TAG=                # Amazon Associates UK store ID, e.g. sydmoore-21

# Only for local testing of the sub-folder preview build, e.g. /Syd-Moore-Website.
# The deploy workflow sets this automatically.
SITE_BASE=
