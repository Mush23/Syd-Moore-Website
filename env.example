# Copy to .env for local development. In production, set these in
# Cloudflare Pages → your project → Settings → Variables and secrets.

# Build-time (public) values
PUBLIC_KIT_FORM_ACTION=           # e.g. https://app.kit.com/forms/1234567/subscriptions
PUBLIC_CF_ANALYTICS_TOKEN=        # Cloudflare Web Analytics token
PUBLIC_AMAZON_TAG=                # Amazon Associates UK store ID, e.g. sydmoore-21
PUBLIC_CONTACT_FORM=false         # set to true once the four contact secrets below are configured
PUBLIC_TURNSTILE_SITE_KEY=        # Turnstile site key (public)

# Runtime secrets for functions/api/contact.ts (set as encrypted secrets, never commit)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
